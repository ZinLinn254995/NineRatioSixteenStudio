# ==============================================================================
# Server-Side Secrets & Configuration (NEVER expose to frontend / Vite bundle)
# ==============================================================================
GEMINI_API_KEY=

# Optional server-side Firebase ID token verification overrides
# (Defaults to projectId from firebase-applet-config.json when omitted)
FIREBASE_PROJECT_ID=
FIREBASE_OWNER_UID=
FIREBASE_OWNER_EMAIL=

# ==============================================================================
# Public Client Firebase Configuration (Optional override for manual setup)
# Note: In AI Studio, firebase-applet-config.json provides these public web SDK
# values automatically. Only fill these if connecting to a separate manual
# Firebase project. Never place service account keys or private secrets here.
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_OWNER_EMAIL=

