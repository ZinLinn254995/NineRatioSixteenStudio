rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Global default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isVerifiedOwner(userId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId
        && request.auth.token.email == 'zla264995@gmail.com';
    }

    function isSafeFileName(fileName) {
      return fileName.size() >= 1
        && fileName.size() <= 180
        && fileName.matches('^[a-zA-Z0-9._\\-]+$');
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isAllowedVideo() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 250 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    function isAllowedCreativeAsset() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 250 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType.matches('video/(mp4|webm|quicktime)')
          || request.resource.contentType.matches('audio/(mpeg|mp4|wav|webm)')
          || request.resource.contentType in ['text/plain', 'text/vtt', 'application/x-subrip']
        );
    }

    match /users/{userId}/product-images/{fileName} {
      allow read: if isVerifiedOwner(userId) && isSafeFileName(fileName);
      allow create, update: if isVerifiedOwner(userId) && isSafeFileName(fileName) && isAllowedImage();
      allow delete: if isVerifiedOwner(userId) && isSafeFileName(fileName);
    }

    match /users/{userId}/reference-images/{fileName} {
      allow read: if isVerifiedOwner(userId) && isSafeFileName(fileName);
      allow create, update: if isVerifiedOwner(userId) && isSafeFileName(fileName) && isAllowedImage();
      allow delete: if isVerifiedOwner(userId) && isSafeFileName(fileName);
    }

    match /users/{userId}/generated-videos/{fileName} {
      allow read: if isVerifiedOwner(userId) && isSafeFileName(fileName);
      allow create, update: if isVerifiedOwner(userId) && isSafeFileName(fileName) && isAllowedVideo();
      allow delete: if isVerifiedOwner(userId) && isSafeFileName(fileName);
    }

    match /users/{userId}/symphony-videos/{fileName} {
      allow read: if isVerifiedOwner(userId) && isSafeFileName(fileName);
      allow create, update: if isVerifiedOwner(userId) && isSafeFileName(fileName) && isAllowedVideo();
      allow delete: if isVerifiedOwner(userId) && isSafeFileName(fileName);
    }

    match /users/{userId}/creative-assets/{fileName} {
      allow read: if isVerifiedOwner(userId) && isSafeFileName(fileName);
      allow create, update: if isVerifiedOwner(userId) && isSafeFileName(fileName) && isAllowedCreativeAsset();
      allow delete: if isVerifiedOwner(userId) && isSafeFileName(fileName);
    }
  }
}
