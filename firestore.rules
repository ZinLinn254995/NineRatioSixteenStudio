rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Hardened Global Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Single-owner personal platform access gate (requires verified owner email)
    function isVerifiedOwner() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'zla264995@gmail.com';
    }

    function isOwner(userId) {
      return isVerifiedOwner() && request.auth.uid == userId;
    }

    function ownerProfileExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function productExists(userId, productId) {
      return exists(/databases/$(database)/documents/users/$(userId)/affiliateProducts/$(productId));
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalId(data, key) {
      return !(key in data) || isValidId(data[key]);
    }

    function isOptionalNumber(data, key, minVal, maxVal) {
      return !(key in data) || (data[key] is number && data[key] >= minVal && data[key] <= maxVal);
    }

    function isValidLanguage(val) {
      return val in ['th', 'my', 'th_my'];
    }

    function isValidCurrency(val) {
      return val in ['THB', 'MMK', 'USD'];
    }

    function isValidCreateTimestamps(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isValidUpdateTimestamps() {
      return incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
    }

    // =========================================================================
    // Entity Validation Blueprints (Pillar 2: Anti-Update-Gap)
    // =========================================================================

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'ownerUid', 'email', 'preferredUiLanguage', 'defaultContentLanguage',
          'currency', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'email', 'displayName', 'photoUrl',
          'preferredUiLanguage', 'defaultContentLanguage', 'currency',
          'region', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isValidString(data.email, 3, 254)
        && data.email == request.auth.token.email
        && isOptionalString(data, 'displayName', 120)
        && isOptionalString(data, 'photoUrl', 1000)
        && data.preferredUiLanguage in ['en', 'th', 'my']
        && isValidLanguage(data.defaultContentLanguage)
        && isValidCurrency(data.currency)
        && isOptionalString(data, 'region', 32);
    }

    function isValidAffiliateProduct(data) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'targetLanguage', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'category', 'tiktokShopUrl', 'priceThb',
          'commissionRatePct', 'targetLanguage', 'sellingPoints',
          'complianceNotes', 'tags', 'primaryImageAssetId', 'status',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isValidString(data.name, 1, 200)
        && isOptionalString(data, 'category', 100)
        && isOptionalString(data, 'tiktokShopUrl', 1000)
        && isOptionalNumber(data, 'priceThb', 0, 10000000)
        && isOptionalNumber(data, 'commissionRatePct', 0, 100)
        && isValidLanguage(data.targetLanguage)
        && isOptionalString(data, 'sellingPoints', 4000)
        && isOptionalString(data, 'complianceNotes', 2000)
        && (!('tags' in data) || (
          data.tags is list
          && data.tags.size() <= 15
          && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 50))
        ))
        && isOptionalId(data, 'primaryImageAssetId')
        && data.status in ['researching', 'shortlisted', 'active', 'paused', 'archived'];
    }

    function isValidProductResearch(data) {
      return data.keys().hasAll([
          'ownerUid', 'productId', 'title', 'language', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'productId', 'title', 'language',
          'audiencePainPoints', 'buyerObjections', 'winningAngles',
          'sourceNotes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isValidId(data.productId)
        && isValidString(data.title, 1, 200)
        && isValidLanguage(data.language)
        && isOptionalString(data, 'audiencePainPoints', 4000)
        && isOptionalString(data, 'buyerObjections', 4000)
        && isOptionalString(data, 'winningAngles', 4000)
        && isOptionalString(data, 'sourceNotes', 4000);
    }

    function isValidCompetitorResearch(data) {
      return data.keys().hasAll([
          'ownerUid', 'creatorHandle', 'language', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'productId', 'creatorHandle', 'videoUrl', 'language',
          'hookSummary', 'structureNotes', 'ctaStyle', 'keyTakeaways',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isOptionalId(data, 'productId')
        && isValidString(data.creatorHandle, 1, 120)
        && isOptionalString(data, 'videoUrl', 1000)
        && isValidLanguage(data.language)
        && isOptionalString(data, 'hookSummary', 2000)
        && isOptionalString(data, 'structureNotes', 4000)
        && isOptionalString(data, 'ctaStyle', 500)
        && isOptionalString(data, 'keyTakeaways', 4000);
    }

    function isValidMarketingCampaign(data) {
      return data.keys().hasAll([
          'ownerUid', 'productId', 'title', 'targetLanguage', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'productId', 'title', 'goal', 'targetLanguage',
          'status', 'strategyNotes', 'startDate', 'endDate',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isValidId(data.productId)
        && isValidString(data.title, 1, 200)
        && isOptionalString(data, 'goal', 500)
        && isValidLanguage(data.targetLanguage)
        && data.status in ['draft', 'active', 'paused', 'completed', 'archived']
        && isOptionalString(data, 'strategyNotes', 6000)
        && isOptionalString(data, 'startDate', 32)
        && isOptionalString(data, 'endDate', 32);
    }

    function isValidContentPlan(data) {
      return data.keys().hasAll([
          'ownerUid', 'title', 'language', 'stage', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'campaignId', 'productId', 'title', 'language', 'stage',
          'scheduledDate', 'scriptId', 'assetId', 'postedUrl', 'notes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isOptionalId(data, 'campaignId')
        && isOptionalId(data, 'productId')
        && isValidString(data.title, 1, 200)
        && isValidLanguage(data.language)
        && data.stage in [
          'idea', 'scripted', 'symphony_handoff', 'video_studio_edit',
          'ready_to_post', 'posted', 'archived'
        ]
        && isOptionalString(data, 'scheduledDate', 32)
        && isOptionalId(data, 'scriptId')
        && isOptionalId(data, 'assetId')
        && isOptionalString(data, 'postedUrl', 1000)
        && isOptionalString(data, 'notes', 4000);
    }

    function isValidAffiliateScript(data) {
      return data.keys().hasAll([
          'ownerUid', 'title', 'language', 'tone', 'version',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'campaignId', 'productId', 'title', 'language', 'tone',
          'hook', 'body', 'cta', 'onScreenCaptions', 'symphonyPrompt',
          'version', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isOptionalId(data, 'campaignId')
        && isOptionalId(data, 'productId')
        && isValidString(data.title, 1, 200)
        && isValidLanguage(data.language)
        && data.tone in ['casual', 'polite', 'urgent', 'storytelling', 'review']
        && isOptionalString(data, 'hook', 1500)
        && isOptionalString(data, 'body', 8000)
        && isOptionalString(data, 'cta', 1500)
        && isOptionalString(data, 'onScreenCaptions', 4000)
        && isOptionalString(data, 'symphonyPrompt', 4000)
        && data.version is number && data.version >= 1 && data.version <= 1000;
    }

    function isValidCreativeAssetMetadata(data) {
      return data.keys().hasAll([
          'ownerUid', 'category', 'source', 'fileName', 'mimeType',
          'sizeBytes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'campaignId', 'productId', 'category', 'source',
          'fileName', 'mimeType', 'sizeBytes', 'durationSec', 'storagePath',
          'downloadUrl', 'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isOptionalId(data, 'campaignId')
        && isOptionalId(data, 'productId')
        && data.category in [
          'product-images', 'reference-images', 'generated-videos',
          'symphony-videos', 'creative-assets'
        ]
        && data.source in ['local', 'symphony', 'video_studio', 'external']
        && isValidString(data.fileName, 1, 200)
        && isValidString(data.mimeType, 3, 100)
        && data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 524288000
        && isOptionalNumber(data, 'durationSec', 0, 86400)
        && isOptionalString(data, 'storagePath', 500)
        && isOptionalString(data, 'downloadUrl', 1500)
        && isOptionalString(data, 'notes', 2000);
    }

    function isValidVideoProductionRecord(data) {
      return data.keys().hasAll([
          'ownerUid', 'title', 'symphonyWorkflow', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'campaignId', 'scriptId', 'title', 'symphonyWorkflow',
          'status', 'sourceAssetId', 'outputAssetId', 'localStudioProjectId',
          'notes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isOptionalId(data, 'campaignId')
        && isOptionalId(data, 'scriptId')
        && isValidString(data.title, 1, 200)
        && data.symphonyWorkflow in ['none', 'video_gen', 'avatar', 'dubbing', 'creative_edit']
        && data.status in [
          'planned', 'symphony_prepared', 'symphony_imported',
          'editing_in_studio', 'exported', 'published', 'archived'
        ]
        && isOptionalId(data, 'sourceAssetId')
        && isOptionalId(data, 'outputAssetId')
        && isOptionalId(data, 'localStudioProjectId')
        && isOptionalString(data, 'notes', 4000);
    }

    function isValidAnalyticsRecord(data) {
      return data.keys().hasAll([
          'ownerUid', 'recordedDate', 'views', 'productClicks', 'orders',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'campaignId', 'contentPlanId', 'recordedDate',
          'views', 'likes', 'comments', 'shares', 'productClicks', 'orders',
          'sourceNote', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isOptionalId(data, 'campaignId')
        && isOptionalId(data, 'contentPlanId')
        && isValidString(data.recordedDate, 8, 32)
        && data.views is number && data.views >= 0 && data.views <= 1000000000
        && isOptionalNumber(data, 'likes', 0, 1000000000)
        && isOptionalNumber(data, 'comments', 0, 1000000000)
        && isOptionalNumber(data, 'shares', 0, 1000000000)
        && data.productClicks is number && data.productClicks >= 0 && data.productClicks <= 1000000000
        && data.orders is number && data.orders >= 0 && data.orders <= 100000000
        && isOptionalString(data, 'sourceNote', 500);
    }

    function isValidEarningsRecord(data) {
      return data.keys().hasAll([
          'ownerUid', 'recordedDate', 'currency', 'gmvAmount',
          'commissionAmount', 'ordersCount', 'settlementStatus',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'campaignId', 'productId', 'recordedDate', 'currency',
          'gmvAmount', 'commissionAmount', 'ordersCount', 'settlementStatus',
          'sourceNote', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isOptionalId(data, 'campaignId')
        && isOptionalId(data, 'productId')
        && isValidString(data.recordedDate, 8, 32)
        && isValidCurrency(data.currency)
        && data.gmvAmount is number && data.gmvAmount >= 0 && data.gmvAmount <= 1000000000
        && data.commissionAmount is number && data.commissionAmount >= 0 && data.commissionAmount <= 1000000000
        && data.ordersCount is number && data.ordersCount >= 0 && data.ordersCount <= 100000000
        && data.settlementStatus in ['estimated', 'pending', 'settled', 'cancelled']
        && isOptionalString(data, 'sourceNote', 500);
    }

    // =========================================================================
    // Owner Profile & Subcollections (Exhaustive Blueprint Coverage)
    // =========================================================================
    match /users/{userId} {
      // PII Isolation: strictly owner-only get; listing users is forbidden.
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && isValidCreateTimestamps(incoming());
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().email == existing().email
        && isValidUpdateTimestamps()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoUrl', 'preferredUiLanguage',
          'defaultContentLanguage', 'currency', 'region', 'updatedAt'
        ]);
      allow delete: if false;

      match /affiliateProducts/{productId} {
        allow get: if isOwner(userId) && isValidId(productId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(productId)
          && isValidAffiliateProduct(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId);
        allow update: if isOwner(userId)
          && isValidId(productId)
          && isValidAffiliateProduct(incoming())
          && incoming().ownerUid == existing().ownerUid
          && isValidUpdateTimestamps()
          && existing().status != 'archived'
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'category', 'tiktokShopUrl', 'priceThb',
              'commissionRatePct', 'targetLanguage', 'sellingPoints',
              'complianceNotes', 'tags', 'primaryImageAssetId', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(productId);
      }

      match /productResearch/{researchId} {
        allow get: if isOwner(userId) && isValidId(researchId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(researchId)
          && isValidProductResearch(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId)
          && productExists(userId, incoming().productId);
        allow update: if isOwner(userId)
          && isValidId(researchId)
          && isValidProductResearch(incoming())
          && incoming().ownerUid == existing().ownerUid
          && incoming().productId == existing().productId
          && isValidUpdateTimestamps()
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'language', 'audiencePainPoints', 'buyerObjections',
            'winningAngles', 'sourceNotes', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(researchId);
      }

      match /competitorResearch/{competitorId} {
        allow get: if isOwner(userId) && isValidId(competitorId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(competitorId)
          && isValidCompetitorResearch(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId);
        allow update: if isOwner(userId)
          && isValidId(competitorId)
          && isValidCompetitorResearch(incoming())
          && incoming().ownerUid == existing().ownerUid
          && isValidUpdateTimestamps()
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'productId', 'creatorHandle', 'videoUrl', 'language',
            'hookSummary', 'structureNotes', 'ctaStyle', 'keyTakeaways', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(competitorId);
      }

      match /marketingCampaigns/{campaignId} {
        allow get: if isOwner(userId) && isValidId(campaignId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(campaignId)
          && isValidMarketingCampaign(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId)
          && productExists(userId, incoming().productId);
        allow update: if isOwner(userId)
          && isValidId(campaignId)
          && isValidMarketingCampaign(incoming())
          && incoming().ownerUid == existing().ownerUid
          && incoming().productId == existing().productId
          && isValidUpdateTimestamps()
          && existing().status != 'archived'
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'goal', 'targetLanguage', 'strategyNotes',
              'startDate', 'endDate', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(campaignId);
      }

      match /contentPlans/{planId} {
        allow get: if isOwner(userId) && isValidId(planId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(planId)
          && isValidContentPlan(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId);
        allow update: if isOwner(userId)
          && isValidId(planId)
          && isValidContentPlan(incoming())
          && incoming().ownerUid == existing().ownerUid
          && isValidUpdateTimestamps()
          && existing().stage != 'archived'
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'campaignId', 'productId', 'title', 'language', 'scheduledDate',
              'scriptId', 'assetId', 'postedUrl', 'notes', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'postedUrl', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(planId);
      }

      match /scripts/{scriptId} {
        allow get: if isOwner(userId) && isValidId(scriptId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(scriptId)
          && isValidAffiliateScript(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId);
        allow update: if isOwner(userId)
          && isValidId(scriptId)
          && isValidAffiliateScript(incoming())
          && incoming().ownerUid == existing().ownerUid
          && isValidUpdateTimestamps()
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'campaignId', 'productId', 'title', 'language', 'tone',
            'hook', 'body', 'cta', 'onScreenCaptions', 'symphonyPrompt',
            'version', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(scriptId);
      }

      match /creativeAssets/{assetId} {
        allow get: if isOwner(userId) && isValidId(assetId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(assetId)
          && isValidCreativeAssetMetadata(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId);
        allow update: if isOwner(userId)
          && isValidId(assetId)
          && isValidCreativeAssetMetadata(incoming())
          && incoming().ownerUid == existing().ownerUid
          && incoming().category == existing().category
          && isValidUpdateTimestamps()
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'campaignId', 'productId', 'fileName', 'durationSec',
            'storagePath', 'downloadUrl', 'notes', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(assetId);
      }

      match /videoProductions/{productionId} {
        allow get: if isOwner(userId) && isValidId(productionId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(productionId)
          && isValidVideoProductionRecord(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId);
        allow update: if isOwner(userId)
          && isValidId(productionId)
          && isValidVideoProductionRecord(incoming())
          && incoming().ownerUid == existing().ownerUid
          && isValidUpdateTimestamps()
          && existing().status != 'archived'
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'campaignId', 'scriptId', 'title', 'symphonyWorkflow',
              'sourceAssetId', 'outputAssetId', 'localStudioProjectId',
              'notes', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'outputAssetId', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(productionId);
      }

      match /analyticsRecords/{analyticsId} {
        allow get: if isOwner(userId) && isValidId(analyticsId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(analyticsId)
          && isValidAnalyticsRecord(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId);
        allow update: if isOwner(userId)
          && isValidId(analyticsId)
          && isValidAnalyticsRecord(incoming())
          && incoming().ownerUid == existing().ownerUid
          && isValidUpdateTimestamps()
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'campaignId', 'contentPlanId', 'recordedDate', 'views', 'likes',
            'comments', 'shares', 'productClicks', 'orders', 'sourceNote', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(analyticsId);
      }

      match /earningsRecords/{earningsId} {
        allow get: if isOwner(userId) && isValidId(earningsId);
        allow list: if isOwner(userId) && resource.data.ownerUid == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(earningsId)
          && isValidEarningsRecord(incoming())
          && isValidCreateTimestamps(incoming())
          && ownerProfileExists(userId);
        allow update: if isOwner(userId)
          && isValidId(earningsId)
          && isValidEarningsRecord(incoming())
          && incoming().ownerUid == existing().ownerUid
          && isValidUpdateTimestamps()
          && existing().settlementStatus != 'settled'
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'campaignId', 'productId', 'recordedDate', 'currency',
              'gmvAmount', 'commissionAmount', 'ordersCount', 'sourceNote', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly(['settlementStatus', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(earningsId) && existing().settlementStatus != 'settled';
      }
    }
  }
}
