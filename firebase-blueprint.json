      },
      "description": "Owner-scoped affiliate marketing campaigns."
    },
    "/users/{userId}/contentPlans/{planId}": {
      "schema": {
        "$ref": "#/entities/ContentPlan"
      },
      "description": "Owner-scoped content calendar and pipeline items."
    },
    "/users/{userId}/scripts/{scriptId}": {
      "schema": {
        "$ref": "#/entities/AffiliateScript"
      },
      "description": "Owner-scoped Thai and Myanmar affiliate scripts."
    },
    "/users/{userId}/creativeAssets/{assetId}": {
