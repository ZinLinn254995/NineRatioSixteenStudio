        "category": {
          "type": "string",
          "maxLength": 100
        },
        "tiktokShopUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        },
        "priceThb": {
          "type": "number"
        },
        "commissionRatePct": {
          "type": "number"
        },
        "targetLanguage": {
          "type": "string",
          "enum": ["th", "my", "th_my"]
        },
        "sellingPoints": {
          "type": "string",
          "maxLength": 4000
        },
        "complianceNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "description": "Up to 15 short product tags."
        },
        "primaryImageAssetId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["researching", "shortlisted", "active", "paused", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "name",
        "targetLanguage",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
