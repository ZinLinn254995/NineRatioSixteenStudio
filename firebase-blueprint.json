{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Single-owner creator profile and workspace preferences for NineRatioSixteenStudio.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the platform owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified owner email address.",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Owner display name.",
          "maxLength": 120
        },
        "photoUrl": {
          "type": "string",
          "format": "uri",
          "description": "Optional owner profile image URL.",
          "maxLength": 1000
        },
        "preferredUiLanguage": {
          "type": "string",
          "enum": ["en", "th", "my"],
          "description": "Preferred interface language."
        },
        "defaultContentLanguage": {
          "type": "string",
          "enum": ["th", "my", "th_my"],
          "description": "Default TikTok affiliate content language."
        },
        "currency": {
          "type": "string",
          "enum": ["THB", "MMK", "USD"],
          "description": "Primary earnings reporting currency."
        },
        "region": {
          "type": "string",
          "description": "Creator operating market region.",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "email",
        "preferredUiLanguage",
        "defaultContentLanguage",
        "currency",
        "createdAt",
        "updatedAt"
      ]
    },
    "AffiliateProduct": {
      "title": "AffiliateProduct",
      "description": "TikTok Shop Thailand affiliate product record.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
